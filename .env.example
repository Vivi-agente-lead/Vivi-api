APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

POSTGRES_USER=vivi
POSTGRES_PASSWORD=vivi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vivi

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
